# =========================================================
# ClubTrack Full Stack (Hito 3) — Variables de Entorno
# Copia este archivo como .env si deseas personalizar puertos o credenciales.
# =========================================================

# PostgreSQL (Base de datos Relacional SQL)
PG_HOST=localhost
PG_PORT=5432
PG_USER=clubtrack
PG_PASSWORD=clubtrack_pass
PG_DATABASE=clubtrack_db

# MongoDB (Base de datos Documental NoSQL)
MONGO_URI=mongodb://localhost:27017/clubtrack_nosql

# Backend API REST
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend React (Vite)
VITE_API_URL=http://localhost:4000/api
